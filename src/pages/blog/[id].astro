---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <a class="back" href="/"><span aria-hidden="true">←</span> 返回文章列表</a>
    <header class="article-header">
      <div class="meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}</div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
    </header>
    <div class="article-body"><Content /></div>
    {post.data.originalUrl && <div class="source">原文发布于 <a href={post.data.originalUrl} target="_blank" rel="noopener noreferrer">{new URL(post.data.originalUrl).hostname} ↗</a></div>}
    <div class="article-end"><a href="/">← 返回文章列表</a></div>
  </article>
</BaseLayout>

<style>
  .article { padding: 57px 0 104px; }
  .back { text-decoration: none; color: #888981; font-size: 13px; }
  .back:hover, .article-end a:hover { color: #a64f32; }
  .back span { margin-right: 8px; }
  .article-header { padding: 69px 0 44px; border-bottom: 1px solid #dcd9d1; }
  .meta { color: #9a6b52; font-size: 12px; display: flex; align-items: center; gap: 14px; }
  .tag { color: #8e8d85; padding-left: 14px; border-left: 1px solid #d6d2c9; }
  h1 { font-size: clamp(34px, 5.6vw, 52px); line-height: 1.34; letter-spacing: -.045em; margin: 18px 0 16px; font-weight: 650; }
  .article-header p { font-size: 15px; color: #8a8b84; line-height: 1.8; margin: 0; }
  .article-body { max-width: 720px; padding-top: 34px; color: #3a3c37; font-size: 16px; line-height: 1.95; overflow-wrap: anywhere; }
  .article-body :global(h2) { margin: 2.3em 0 .6em; font-size: 25px; line-height: 1.45; letter-spacing: -.025em; }
  .article-body :global(h3) { margin: 2em 0 .55em; font-size: 20px; line-height: 1.5; }
  .article-body :global(p), .article-body :global(ul), .article-body :global(ol) { margin: 1.25em 0; }
  .article-body :global(li) { margin: .38em 0; }
  .article-body :global(a) { color: #a64f32; text-underline-offset: 4px; }
  .article-body :global(blockquote) { margin: 2em 0; padding: .1em 0 .1em 22px; border-left: 3px solid #c99d84; color: #77776e; }
  .article-body :global(img) { max-width: 100%; height: auto; border-radius: 4px; }
  .article-body :global(pre) { overflow-x: auto; padding: 20px 23px; border-radius: 6px; background: #292c29 !important; color: #f1ede5; font-size: 13px; line-height: 1.7; }
  .article-body :global(:not(pre) > code) { padding: .18em .4em; border-radius: 3px; background: #edeae3; font-size: .88em; }
  .article-body :global(table) { width: 100%; border-collapse: collapse; display: block; overflow-x: auto; font-size: 14px; }
  .article-body :global(th), .article-body :global(td) { padding: 9px 13px; border: 1px solid #ddd9d1; }
  .article-body :global(hr) { border: 0; border-top: 1px solid #ddd9d1; margin: 2.6em 0; }
  .source { border-top: 1px solid #e4e0d9; margin-top: 65px; padding-top: 22px; color: #9a9a92; font-size: 12px; }
  .source a { color: #a64f32; text-decoration: none; }
  .article-end { margin-top: 67px; }
  .article-end a { color: #686963; font-size: 13px; text-decoration: none; }
  @media (max-width: 600px) { .article { padding: 40px 0 80px; } .article-header { padding: 59px 0 33px; } .article-body { font-size: 15px; } }
</style>
